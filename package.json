{
  "name": "debabufy",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop automation for repetitive Indian administrative workflows",
  "type": "module",
  "main": "apps/desktop/main.js",
  "license": "MIT",
  "author": "DeBabufy contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bagdeabhishek/debabufy.git"
  },
  "bugs": {
    "url": "https://github.com/bagdeabhishek/debabufy/issues"
  },
  "homepage": "https://github.com/bagdeabhishek/debabufy#readme",
  "keywords": [
    "automation",
    "desktop",
    "form-141",
    "india",
    "local-first",
    "playwright"
  ],
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "cli:form141": "node workflows/form-141/cli.js"
  },
  "dependencies": {
    "pdfjs-dist": "^6.1.200",
    "playwright-core": "^1.62.1"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@11.16.0",
  "build": {
    "appId": "dev.debabufy.desktop",
    "productName": "DeBabufy",
    "asar": true,
    "compression": "maximum",
    "artifactName": "DeBabufy-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "apps/desktop/**/*",
      "workflows/registry.js",
      "workflows/form-141/index.js",
      "workflows/form-141/workflow.json",
      "workflows/form-141/cli.js",
      "workflows/form-141/cli/**/*",
      "workflows/form-141/src/**/*",
      "workflows/form-141/browser/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
